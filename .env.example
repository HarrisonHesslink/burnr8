GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-id-no-dashes

# ---- Meta Marketing API (Optional) ----
# Required for Facebook/Instagram Reels campaign tools. The token needs ads_management.
META_ACCESS_TOKEN=your-meta-access-token
# Recommended when App Secret Proof is enabled for your Meta app.
META_APP_SECRET=your-meta-app-secret
META_AD_ACCOUNT_ID=your-meta-ad-account-id-no-act-prefix
META_GRAPH_API_VERSION=v25.0
# Meta image tools can only read JPEG/PNG files beneath this directory.
BURNR8_MEDIA_ROOT=/absolute/path/to/approved/ad-photos

# ---- Google SEO Intelligence (Optional) ----
# Search Console needs a separate refresh token authorized for webmasters.readonly.
# Use the full webmasters scope only if you want gsc_submit_sitemap.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=your-search-console-refresh-token
# Optional: falls back to GOOGLE_ADS_CLIENT_ID / GOOGLE_ADS_CLIENT_SECRET when omitted.
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your-oauth-client-id
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:example.com
# PageSpeed accepts keyless requests, but configure a key for reliable quota.
# GOOGLE_PAGESPEED_API_KEY=your-google-api-key
# CrUX requires a key and falls back to GOOGLE_PAGESPEED_API_KEY when omitted.
# GOOGLE_CRUX_API_KEY=your-google-api-key
# BURNR8_SEO_MAX_CRAWL_PAGES=100

# ---- Reddit Ads API (Optional) ----
# Run burnr8-reddit-setup for OAuth with adsread and adsedit.
# Register http://localhost:8765/callback in Business > Developer Portal first.
REDDIT_CLIENT_ID=your-reddit-app-id
REDDIT_CLIENT_SECRET=your-reddit-app-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token
REDDIT_AD_ACCOUNT_ID=a2_youraccount
# Optional descriptive identifier, e.g. script:burnr8:v0.7.1 (by /u/yourusername)
# REDDIT_USER_AGENT=burnr8/0.7.1 (Reddit Ads API)
# Optional short-lived token for diagnostics; overrides refresh-token auth when set.
# REDDIT_ACCESS_TOKEN=your-temporary-access-token
# Separate conversion token for a website/server CAPI integration; Burnr8 management tools do not use it.
# REDDIT_CAPI_ACCESS_TOKEN=your-conversion-access-token
# Ceiling for campaign lifetime spend caps, in USD.
# BURNR8_REDDIT_MAX_SPEND_CAP_DOLLARS=1000

# ---- Financial Circuit Breakers (Optional) ----
# Hard-caps to prevent catastrophic spend from AI hallucinations.
# Defaults are shown below. 
# BURNR8_MAX_DAILY_BUDGET_DOLLARS=10000
# BURNR8_MAX_CPC_BID_DOLLARS=100
# BURNR8_MAX_BID_MODIFIER=5.0
# BURNR8_MAX_TARGET_CPA_DOLLARS=500
# BURNR8_MIN_TARGET_ROAS=0.5
